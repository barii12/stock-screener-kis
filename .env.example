# 한국투자증권 OPEN API 정보
# https://apiportal.koreainvestment.com/ 에서 신청 후 입력

# API 앱 키 (한국투자증권에서 발급)
KIS_API_KEY=YOUR_APP_KEY_HERE

# API 앱 시크릿 (한국투자증권에서 발급)
KIS_SECRET_KEY=YOUR_APP_SECRET_HERE

# 계좌번호 (예: 12345678)
KIS_ACCOUNT=YOUR_ACCOUNT_NUMBER_HERE

# 계좌 코드 (보통 00)
KIS_ACCOUNT_CODE=00

# 포트 (기본값: 5000)
PORT=5000

# Node 환경
NODE_ENV=production
